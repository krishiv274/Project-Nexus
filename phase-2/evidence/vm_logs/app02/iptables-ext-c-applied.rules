# Extension C rules as applied on app02 (Backend B, port 3002), in iptables-save format,
# including the edge02 rule added for Extension E (PHASE2_GUIDE.md Step 6.2).
# NOTE: reconstructed from the commands visible in images/p2_fig16_firewall_rules.png (rules 1-3)
# and images/p2_fig23_firewall_rollback.png (the -s 10.211.55.7 rule deleted at rollback);
# not captured with iptables-save while active.
# Restore:  sudo iptables-restore < iptables-ext-c-applied.rules
# Rollback: sudo iptables-restore < iptables-before-ext-c.rules
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
# 1. local traffic
-A INPUT -i lo -p tcp -m tcp --dport 3002 -j ACCEPT
# 2. primary edge edge01
-A INPUT -s 10.211.55.6/32 -p tcp -m tcp --dport 3002 -j ACCEPT
# 3. standby edge edge02 (app01), added before the Extension E cutover
-A INPUT -s 10.211.55.7/32 -p tcp -m tcp --dport 3002 -j ACCEPT
# 4. everyone else is silently dropped
-A INPUT -p tcp -m tcp --dport 3002 -j DROP
COMMIT
